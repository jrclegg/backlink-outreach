{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google/apiclient": "^2.19",
        "laravel/fortify": "^1.38",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^2.10.1",
        "league/csv": "^9.28",
        "livewire/flux": "^2.16",
        "livewire/livewire": "^4.4",
        "symfony/dom-crawler": "^7.4",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#a7f3d0,#fcd34d,#fdba74,#f9a8d4\" \"php artisan serve\" \"php artisan queue:listen --queue=default --tries=3 --timeout=720\" \"php artisan queue:listen --queue=outgoing --tries=1 --timeout=90 --sleep=1\" \"php artisan queue:listen --queue=employer-quality,employer-research,research --tries=1 --timeout=720\" \"php artisan schedule:work\" \"npm run dev\" --names=server,mail,outgoing,research,scheduler,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "automation": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently --names=mail,outgoing,quality,research,scheduler \"php artisan queue:work --queue=default --tries=3 --timeout=720\" \"php artisan queue:work --queue=outgoing --tries=1 --timeout=90 --sleep=1\" \"php artisan queue:work --queue=employer-quality --tries=1 --timeout=720\" \"php artisan queue:work --queue=employer-research,research --tries=1 --timeout=720\" \"php artisan schedule:work\" --restart-tries=-1 --restart-after=5000"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
